watch_file .nix/direnv.sh
watch_file .purpose/flake-source-policy.v1.json
watch_file tools/flake-source-helper/default.nix
source_env .nix/direnv.sh || return $?

if command -v direnv >/dev/null 2>&1; then
  _dotfiles_helper=$(nix build --impure --no-link --print-out-paths --file tools/flake-source-helper/default.nix) || return $?
  _dotfiles_source=$("$_dotfiles_helper/bin/ergo-flake-source" "$PWD") || return $?
  use flake "$_dotfiles_source" || return $?
  export REPOSITORY_OPERATOR_FLAKE_SOURCE_BIN="$_dotfiles_helper/bin/ergo-flake-source"
  unset _dotfiles_helper _dotfiles_source
fi
