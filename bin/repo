#!/usr/bin/env bash
# Generated by Purpose Tool from .purpose/commands.json. Do not edit.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REPO_JSON_COMPACT=0
REPO_JSON_SELECT=""
while [[ ${#} -gt 0 ]]; do
  case "${1}" in
    --compact)
      REPO_JSON_COMPACT=1
      export REPO_JSON_COMPACT=1
      if [[ -z "${REPO_OUTPUT:-}" ]]; then export REPO_OUTPUT=compact; fi
      shift
      ;;
    --select=*)
      REPO_JSON_SELECT="${1#--select=}}"
      export REPO_JSON_SELECT="$REPO_JSON_SELECT"
      shift
      ;;
    --select)
      shift
      REPO_JSON_SELECT="${1:-}"
      export REPO_JSON_SELECT="$REPO_JSON_SELECT"
      shift
      ;;
    --) break ;;
    -*) shift ;;
    *) break ;;
  esac
done
repo_json_filter() {
  if command -v repo-json-filter >/dev/null 2>&1; then
    repo-json-filter
    return
  fi
  local filter="$ROOT/fabrics/tools/services/purpose-tool/dist/bin/repo-json-filter.js"
  if [[ -f "$filter" ]]; then
    node "$filter"
    return
  fi
  cat
}
resolve_jj_store() {
  local checkout="$1" marker ref
  marker="$checkout/.jj/repo"
  if [[ -d "$marker" && ! -L "$marker" ]]; then
    realpath -e "$marker" 2>/dev/null
    return
  fi
  if [[ -f "$marker" && ! -L "$marker" ]]; then
    IFS= read -r ref < "$marker" || [[ -n "$ref" ]] || return 1
    [[ -n "$ref" ]] || return 1
    if [[ "$ref" == /* ]]; then
      realpath -e "$ref" 2>/dev/null
    else
      realpath -e "$checkout/.jj/$ref" 2>/dev/null
    fi
    return
  fi
  return 1
}
find_caller_workspace() {
  local candidate
  candidate="$(pwd -P)"
  while [[ "$candidate" != "/" ]]; do
    if [[ -d "$candidate/.jj" && ! -L "$candidate/.jj" &&
          -f "$candidate/.purpose/commands.json" && ! -L "$candidate/.purpose/commands.json" &&
          -f "$candidate/bin/repo" && ! -L "$candidate/bin/repo" &&
          -x "$candidate/bin/repo" ]]; then
      printf '%s
' "$candidate"
      return 0
    fi
    candidate="$(dirname "$candidate")"
  done
  return 1
}
# A long-lived client may retain another checkout's generated executable in
# PATH. Rebind only to a regular generated launcher in a checkout that shares
# this launcher's jj store; task-write ownership is still enforced downstream.
if CALLER_ROOT="$(find_caller_workspace)" && [[ "$CALLER_ROOT" != "$ROOT" ]]; then
  ROOT_STORE="$(resolve_jj_store "$ROOT" || true)"
  CALLER_STORE="$(resolve_jj_store "$CALLER_ROOT" || true)"
  if [[ -n "$ROOT_STORE" && "$CALLER_STORE" == "$ROOT_STORE" ]]; then
    exec bash "$CALLER_ROOT/bin/repo" "$@"
  fi
fi
unset CALLER_ROOT ROOT_STORE CALLER_STORE
nix_context_matches_root() {
  local direnv_root repo_command resolved_repo_command
  # Admission belongs to the generated repository root, not to an Engine-only
  # shell marker. The exact-root proof below binds this facade to its own
  # direnv root or resolved launcher path.
  [[ -n "${IN_NIX_SHELL:-}" && "${NIX_DIRENV_DID_FALLBACK:-}" != "1" ]] || return 1
  direnv_root="${DIRENV_DIR:-}"
  direnv_root="${direnv_root#-}"
  if [[ -n "$direnv_root" && "$direnv_root" == "$ROOT" ]]; then
    return 0
  fi
  if [[ -n "$direnv_root" ]]; then
    return 1
  fi
  repo_command="$(command -v repo 2>/dev/null || true)"
  if [[ "$repo_command" == /* ]]; then
    resolved_repo_command="$(realpath -e "$repo_command" 2>/dev/null || true)"
    [[ "$resolved_repo_command" == "$ROOT"/* ]] && return 0
  fi
  return 1
}
run_backend() {
  # Route a command backend through repo-run telemetry when repo-run is on
  # PATH; otherwise execute the backend directly — telemetry absence must
  # never block a repository command. Args: leading NAME=VALUE env
  # assignments (optionally starting with env's "-u NAME" form), then "--",
  # then the backend executable with its args.
  local env_args=()
  while [[ $# -gt 0 && "$1" != "--" ]]; do env_args+=("$1"); shift; done
  if [[ $# -eq 0 ]]; then
    printf 'run_backend: missing -- separator
' >&2
    exit 2
  fi
  shift
  if command -v repo-run >/dev/null 2>&1; then
    env "${env_args[@]}" repo-run -- "$@"
  else
    exec env "${env_args[@]}" "$@"
  fi
}
require_nix_context() {
  nix_context_matches_root && return 0
  printf 'repo: invalid Nix environment for repository root %s
' "$ROOT" >&2
  printf 'Recover with: cd %q && eval "$(direnv export bash)"
' "$ROOT" >&2
  printf 'If the export reports the RC blocked, run direnv allow and rerun the export.
' >&2
  exit 1
}
show_schema() {
  local catalog="$ROOT/.purpose/repo-agent-catalog.json"
  if [[ ! -f "$catalog" ]]; then
    echo "repo agent catalog missing; regenerate with repo prove commands" >&2
    exit 2
  fi
  local body
  if [[ $# -eq 0 ]]; then
    body="$(cat "$catalog")"
  else
    local topic="$*"
    if ! command -v jq >/dev/null 2>&1; then
      echo "repo help schema: jq is required to filter by topic; omit the topic or install jq" >&2
      exit 2
    fi
    body="$(jq --arg topic "$topic" '
      .commands |= map(select((.path | join(" ")) as $p | $p == $topic or ($p | startswith($topic + " "))))
    ' "$catalog")"
  fi
  if [[ "${REPO_OUTPUT:-}" == json || "${REPO_OUTPUT:-}" == compact || "$REPO_JSON_COMPACT" == 1 || -n "$REPO_JSON_SELECT" ]]; then
    printf '%s' "$body" | repo_json_filter
    return
  fi
  printf '%s
' "$body"
}
