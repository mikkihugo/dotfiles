# Copy to otel-ingest.env (chmod 600). Fill from OpenBao:
#   bao kv get -mount=kv tenants/shared/otel-ingest-client
#   bao kv get -mount=kv otel-ingest
#
# Canonical ingest: https://otel-ingest.centralcloud.net (see ~/.agents/host/observability-otel-devbox.md)

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-ingest.centralcloud.net/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Set OTEL_INGEST_USER / OTEL_INGEST_PASSWORD from OpenBao, then:
#   export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic $(printf '%s:%s' "$OTEL_INGEST_USER" "$OTEL_INGEST_PASSWORD" | base64 -w0)"
#
# Or run: ~/.dotfiles/scripts/sync-opencode-swarm-otel-from-bao.sh
# (writes ~/.config/centralcloud/otel-ingest.env for opencode-swarm + serve-with-otel.sh)
OTEL_INGEST_USER=
OTEL_INGEST_PASSWORD=
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_SERVICE_NAME=opencode-swarm
DEPLOYMENT_ENVIRONMENT=dev
