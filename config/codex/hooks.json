{
 "description": "Home Manager owns Codex lifecycle hooks. Transport is repo-memory via CentralCloud MCP gateway (coordination_*). Local filesystem bus is opt-in only. Purpose SessionStart refreshes host skills on bundleHash drift.",
 "hooks": {
  "SessionStart": [
   {
    "matcher": "startup|resume|clear|compact",
    "hooks": [
     {
      "type": "command",
      "command": "/home/mhugo/.codex/hooks/coordination-mailbox-sweep.sh codex SessionStart",
      "timeout": 30,
      "statusMessage": "Joining durable repo-memory coordination"
     },
     {
      "type": "command",
      "command": "/home/mhugo/.codex/hooks/purpose-session-start.sh",
      "timeout": 10,
      "statusMessage": "Syncing Purpose host skills"
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/home/mhugo/.codex/hooks/coordination-mailbox-sweep.sh codex UserPromptSubmit",
      "timeout": 30,
      "statusMessage": "Checking durable repo-memory messages"
     }
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "/home/mhugo/.codex/hooks/observations-autolog.mjs codex Stop",
      "timeout": 30,
      "statusMessage": "Autolog observations to repo_memory"
     }
    ]
   }
  ]
 }
}
