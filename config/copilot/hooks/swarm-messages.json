{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "exec": "/home/mhugo/.nix-profile/bin/bash",
        "args": ["/home/mhugo/.copilot/hooks/coordination-mailbox-sweep.sh", "copilot", "sessionStart"],
