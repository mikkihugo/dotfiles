# Public SSH keys published at https://sshid.io/mhugo, snapshotted 2026-08-08.
#
# Authorised on every host this home-manager config activates, by the
# mergeDeclaredAuthorizedKeys hook in home/modules/activation.nix.
#
# Checked in on purpose: activation never fetches sshid.io. A fetch would make
# login access to these machines grantable by whoever controls that endpoint,
# and would break activation without a network. Refresh this file deliberately
# by re-fetching and reviewing the diff:
#
#     curl -s https://sshid.io/mhugo
#
# The merge is append-only, so deleting a line here does NOT revoke it. To
# revoke a key, remove it from ~/.ssh/authorized_keys on each host as well.
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILX1q4hQJAXGLs8aaSuPuU0tovcF0aDCCriTahe9dSIA #ssh.id - @mhugo
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILgnWZybHdlCZ+p1deORfYX9dJ9BTzj5uzu6F7rcLg2Y #SSH ID - @mhugo
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIH05I5Q9yrnNrVl6tSjWv6q7+SIa+E8snAug8hAN+1fR #ssh.id - @mhugo
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJZqVb24EtRrS6OfWECHvU/l7p7sIRBW9c0CT5IWHL7K #SSH ID - @mhugo
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINaOe4pRYjoKP1eFiN5AaINtV3GBgab56mHWQVAcXnAn #SSH ID - @mhugo
