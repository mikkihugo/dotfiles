# SSH host aliases and the exact key file configured for each block.
# IdentitiesOnly=yes ensures only the listed key is used for authentication.
#
# OpenSSH uses the first obtained value per directive. Forgejo/GitHub mux
# disable must precede Host *; a later host block cannot override ControlPersist.

Host git.infra.centralcloud.com git.centralcloud.net
    HostName git.centralcloud.net
    Port 2222
    User git
    IdentityFile ~/.ssh/personal_admin_id_ed25519
    IdentitiesOnly yes
    ControlMaster no
    ControlPath none
    ControlPersist no

# In-cluster Forgejo service name used by the repository facade.
# `forgejo` is a local convenience alias resolving to the same in-cluster
# transport (git.svc:22); it is not the public edge at git.centralcloud.net:2222.
Host git.svc forgejo
    HostName git.svc
    Port 22
    User git
    IdentityFile ~/.ssh/personal_admin_id_ed25519
    IdentitiesOnly yes
    ControlMaster no
    ControlPath none
    ControlPersist no

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_mikkihugo
    IdentitiesOnly yes
    ControlMaster no
    ControlPath none
    ControlPersist no

# Factory Remote Control (VS Code Remote SSH / `droid computer ssh`).
# Mux off: ProxyCommand + ControlMaster auto from Host * breaks the proxy.
# Identity/known_hosts under ~/.factory/.ssh are created by Factory CLI.
Host factory-*
    ProxyCommand droid computer ssh %h --proxy
    User factory-user
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.factory/.ssh/known_hosts
    IdentityFile ~/.factory/.ssh/id_ed25519
    IdentitiesOnly yes
    ControlMaster no
    ControlPath none
    ControlPersist no

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    AddKeysToAgent yes

Host ai.hugo.dk vpn.hugo.dk jump.hugo.dk
    User root
    IdentityFile ~/.ssh/personal_admin_id_ed25519
    IdentitiesOnly yes

