  "requirements": [
    {
      "id": "R1",
      "statement": "When the enter-once loader fills the agent-direnv dump cache, the written snapshot shall omit DIRENV_DIFF and DIRENV_WATCHES assignments even when direnv emits them on one semicolon-joined line.",
      "acceptance_criteria": [
        "A one-line dump containing export DIRENV_DIFF=$'…'; and export DIRENV_WATCHES=$'…'; is stored without those assignments",
        "Sourcing the dump leaves DIRENV_DIFF and DIRENV_WATCHES unset",
        "Other export assignments from the same line remain"
      ],
      "requirement_form": {
        "ears": {
          "pattern": "event-driven",
          "system": "direnv-export.sh dump fill",
          "trigger": "direnv export bash emits a one-line snapshot containing DIRENV_DIFF and DIRENV_WATCHES",
          "response": "write the dump with those two assignments removed"
        }
      },
      "breaker": {
        "breaker_id": "B1",
        "condition": "cached dump still contains DIRENV_DIFF= or DIRENV_WATCHES=",
        "witness_kind": "contract-test",
        "expected": "rejected"
      },
      "risk": "medium",
      "source": "operator"
    },
    {
      "id": "R2",
      "statement": "When a dump's recorded envrc root no longer contains .envrc, the loader shall not reuse that dump.",
      "acceptance_criteria": [
        "Dump files record # agent-direnv-root:<path>",
        "Eval hit deletes and misses a dump whose recorded root has no .envrc",
        "A subsequent fill may recreate a dump only for a live root"
      ],
      "requirement_form": {
        "ears": {
          "pattern": "unwanted-behavior",
          "system": "direnv-export.sh dump hit",
          "trigger": "a cached dump records a root that no longer has .envrc",
          "response": "refuse the dump rather than source it"
        }
      },
      "breaker": {
        "breaker_id": "B2",
        "condition": "a dump for a deleted root is sourced on the next hit",
        "witness_kind": "contract-test",
        "expected": "rejected"
      },
      "risk": "low",
      "source": "operator"
    }
  ],
