"codex_cli=\"/home/mhugo/.local/bin/codex\"\nif [ -x \"$codex_cli\" ]; then\n  legacy_timer=\"$(/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin/systemctl --user show --property=LoadState --value codex-server-auto-update.timer)\"\n  if [ \"$legacy_timer\" != \"not-found\" ]; then\n    /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin/systemctl --user disable --now codex-server-auto-update.timer\n    /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin/systemctl --user stop codex-server-auto-update.service\n  fi\n\n  legacy_daemon=\"$(/nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin/systemctl --user show --property=LoadState --value codex-managed-daemon.service)\"\n  if [ \"$legacy_daemon\" != \"not-found\" ]; then\n    /nix/store/0xiinbh7pbj479i5v28mqnjrvhvbdibf-systemd-260.2/bin/systemctl --user disable --now codex-managed-daemon.service\n    # Adopt the installed CLI package once, while retiring the old owner.\n    # Subsequent activations leave package updates to native management.\n    \"$codex_cli\" app-server daemon update --from-cli --yes\n  fi\n\n  # Also retire the old projections when these activation entries are\n  # applied alone, without deploying unrelated Home Manager settings.\n  for legacy_unit in codex-managed-daemon.service codex-server-auto-update.service codex-server-auto-update.timer; do\n    legacy_path=\"/home/mhugo/.config/systemd/user/$legacy_unit\"\n    if [ -L \"$legacy_path\" ]; then\n      case \"$(/nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/readlink \"$legacy_path\")\" in\n        /nix/store/*) /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/rm \"$legacy_path\" ;;\n      esac\n    fi\n  done\nfi\n"
