#!/usr/bin/env bash
# The host entry for the repository command surface.
#
# This file lives at ~/.local/bin/repo and shadows every repository's own
# `bin/repo`, because ~/.local/bin precedes the nix profile on PATH.
#
# THE DELEGATE IS RESOLVED FROM THE CALLER'S REPOSITORY, NEVER FROM A CONSTANT.
# An earlier revision resolved it as:
#
#     REPO_BIN="$(command -v repo || true)"
#     [ "$REPO_BIN" = "$(readlink -f "$0")" ] && REPO_BIN=<engine>/bin/repo
#
# `command -v repo` inside this script returns THIS script, so the self-match
# branch always fired and every caller — dotfiles, jcode, infra — was handed
# singularity-engine's facade to run against a foreign tree. A session on
# 2026-09-12 hit exactly that in a .dotfiles worktree, refused with WRONG_REPO
# and killed the process mid-flight.
#
# Resolution walks up from $PWD for the repository that owns the surface and
# then execs THAT repository's surface:
#
#   1. the legacy launcher <root>/bin/<cli_name>, when it is executable;
#   2. otherwise the Engine repository operator, realized from the
#      repository's own flake output (ONE derivation, consumed as-is).
#
# A repository that ships no launcher keeps no launcher: the operator IS the
# surface, and the operator resolves the repository and admits the target
# itself from .purpose/repository-operator-target.v1.json.
#
# Found nothing? REFUSE. Running the wrong repository's surface is worse than
# running none, and a silent fallback is what produced the bug above.

set -euo pipefail

self="$(readlink -f "$0")"

die() {
	printf 'repo: %s\n' "$1" >&2
	exit 2
}

# Walk up for the repository that owns the surface. The operator admission
# declaration comes first (it is what the native operator reads); the Bash-era
# command contract stays as the legacy marker.
repo_root=''
dir="$PWD"
while [ -n "$dir" ] && [ "$dir" != "/" ]; do
	if [ -f "$dir/.purpose/repository-operator-target.v1.json" ] ||
		[ -f "$dir/.purpose/commands.json" ]; then
		repo_root="$dir"
		break
	fi
	dir="$(dirname "$dir")"
done
[ -f "/.purpose/commands.json" ] && [ -z "$repo_root" ] && repo_root="/"
[ -f "/.purpose/repository-operator-target.v1.json" ] && [ -z "$repo_root" ] && repo_root="/"

# Resolve the root PHYSICALLY. Nix refuses to copy a symlinked flake root
# into the store ("error: file '…-source' is a symlink"), and the canonical
# infra checkout IS a symlink (/home/mhugo/code/infra -> /srv/infra). Every
# other participant in this mechanism resolves physically: the legacy
# launcher used `pwd -P`, and infra's own flake sets
# workspace_identity="$(pwd -P)". The logical path is what the walk above
# finds; the physical path is what Nix accepts.
if [ -n "$repo_root" ]; then
	repo_root="$(cd "$repo_root" 2>/dev/null && pwd -P || printf '%s' "$repo_root")"
fi

if [ -z "$repo_root" ]; then
	die "no repository at or above $PWD; refusing rather than guessing a surface.
     cd into a repository, or invoke its operator by path."
fi

# cli_name is declared by the legacy contract; fall back to `repo`.
cli_name='repo'
if [ -f "$repo_root/.purpose/commands.json" ] && command -v jq >/dev/null 2>&1; then
	declared="$(jq -r '.cli_name // "repo"' "$repo_root/.purpose/commands.json" 2>/dev/null || echo repo)"
	[ -n "$declared" ] && [ "$declared" != "null" ] && cli_name="$declared"
fi

resolve_operator() {
	# The operator is one Engine derivation; a repository consumes it from its
	# own flake output. The attribute is a per-repository projection: a
	# repository that declares the operator target consumes the Engine input
	# and exposes it as `ergo`; Engine's own tree exposes it as `ergo` too.
	#
	# Probing the wrong name costs a full flake evaluation, so the attribute
	# is READ from the repository's own output set instead of guessed.
	local root="$1" attr out cache resolved published
	cache="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/repo-shim"
	mkdir -p "$cache" || return 1

	# The cache key covers the lock AND the operator's own source state: Engine
	# builds its operator from the LOCAL tree, so editing the operator source
	# changes the binary without changing flake.lock. A lock-only key served a
	# pre-edit binary until the lock happened to move.
	resolved="$(
		{
			printf '%s' "$root"
			cat "$root/flake.lock" 2>/dev/null
			# The operator source's mtime is enough: a rebuild follows a source
			# edit, and this is a resolution hint, not a content digest.
			find "$root/tools/repository-operator/src" -type f -newer "$root/flake.lock" \
				-printf '%T@ %p\n' 2>/dev/null | sort | sha256sum
		} | sha256sum | cut -c1-16
	)"

	if [ -f "$cache/$resolved" ]; then
		out="$(cat "$cache/$resolved")"
		if [ -x "$out" ]; then
			printf '%s' "$out"
			return 0
		fi
	fi

	# One evaluation lists the published package attributes; the first candidate
	# that is actually there is the one to build. An unknown attribute is an
	# error, so this answers "which exist" without building anything.
	#
	# The apply must RETURN A STRING: --raw refuses to coerce a list, so
	# "--apply builtins.attrNames" fails ("cannot coerce a list to a string")
	# and the probe would silently yield an empty name list. Joining the names
	# into one space-separated string keeps the --raw contract and the word
	# matching below intact.
	published="$(nix eval --raw "path:$root#packages.x86_64-linux" \
		--apply 'x: builtins.concatStringsSep " " (builtins.attrNames x)' 2>/dev/null || true)"
	# When the probe yields nothing (evaluation failed, or the repository
	# publishes no packages set), fall back to trying both candidates rather
	# than skipping them all: skipping every candidate would leave the
	# operator unresolvable where the previous direct build still worked.
	for attr in ergo; do
		if [ -n "$published" ]; then
			case " $published " in
			*" $attr "*) ;;
			*) continue ;;
			esac
		fi
		out="$(nix build --no-link --print-out-paths "path:$root#$attr" 2>/dev/null || true)"
		if [ -z "$out" ]; then
			out="$(nix build --no-link --print-out-paths --offline "path:$root#$attr" 2>/dev/null || true)"
		fi
		if [ -n "$out" ] && [ -x "$out/bin/ergo" ]; then
			printf '%s' "$out/bin/ergo" >"$cache/$resolved" || true
			printf '%s' "$out/bin/ergo"
			return 0
		fi
	done
	return 1
}

REPO_BIN="$repo_root/bin/$cli_name"
if [ -x "$REPO_BIN" ] && [ "$(readlink -f "$REPO_BIN")" != "$self" ]; then
	delegate="$REPO_BIN"
else
	delegate="$(resolve_operator "$repo_root" || true)"
	[ -n "$delegate" ] ||
		die "$repo_root ships no executable launcher and no operator output;
     refusing rather than guessing a surface."
fi

# Engine-only: refresh the protected default workspace before delegating.
# Fenced by the resolved repository root, not by a $PWD prefix match, so a lane
# under a different repository can never trip it.
case "$repo_root" in
/home/mhugo/code/singularity-engine | /home/mhugo/code/singularity-engine/*) ;;
*) exec "$delegate" "$@" ;;
esac

# Skip refresh for cheap, idempotent reads. Keep in sync with
# /home/mhugo/.dotfiles/home/modules/coord if that surface changes.
#
# The operator's public surface is GROUPS (help, check, prove, versions,
# orchestration, lint, pr, issue, label, release, ci, vcs), so a flat word
# like `status` is never a top-level command — it is `vcs status`. Match the
# group, then the cheap read inside it.
case "${1:-}" in
vcs)
	case "${2:-}" in
	log | status | operation-log | operation-show | bookmarks | remote-list | workspace-list | fetch)
		exec "$delegate" "$@"
		;;
	esac
	;;
help | version | versions | coord)
	exec "$delegate" "$@"
	;;
esac

# Refresh the protected default workspace before delegating.
#
# engine-default-refresh.service is a SYSTEM unit (the timer that drives it
# is enabled at the system level). The sudoers rule permits exactly one
# command: `sudo -n <systemctl store path> start --no-block
# engine-default-refresh.service`. There is no `cc-engine-default-refresh`
# binary on PATH, so the old wrapper always failed, and a bare `systemctl
# start` (no sudo, no store path) is refused with "Access denied".
systemctl_bin=""
for candidate in /nix/store/*-systemd-*/bin/systemctl "$(command -v systemctl 2>/dev/null || true)"; do
	[ -x "$candidate" ] && systemctl_bin="$candidate" && break
done
if [ -n "$systemctl_bin" ] && sudo -n true 2>/dev/null; then
	sudo -n "$systemctl_bin" start --no-block engine-default-refresh.service >/dev/null 2>&1 || true
fi

exec "$delegate" "$@"
