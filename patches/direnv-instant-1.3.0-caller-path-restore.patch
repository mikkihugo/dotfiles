+/// Build the `direnv export` command for the background child, running it on
+/// the caller's PATH.
+///
+/// `direnv export` emits an absolute PATH snapshot of the environment it ran
+/// in, so the child's PATH is what every later shell receives. Running the
+/// child on the daemon's own inherited PATH would freeze whatever the daemon
+/// saw when it started -- including repository-local stubs that must not leak
+/// into other repositories. When the caller published a PATH, the child runs
+/// on exactly that; otherwise the inherited PATH is kept.
+pub fn direnv_export_command_with_path(
+    direnv_cmd: &str,
+    shell: Shell,
+    caller_path: Option<&str>,
+) -> Command {
+    let mut cmd = direnv_export_command(direnv_cmd, shell);
+    if let Some(path) = caller_path.filter(|p| !p.is_empty()) {
+        cmd.env("PATH", path);
+    }
+    cmd
+}
