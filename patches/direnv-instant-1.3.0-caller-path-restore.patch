+# Capture the caller's PATH before anything can replace it.
+#
+# The daemon evaluates `direnv export` in a background child. That child
+# inherits the daemon's environment, which is the PATH the shell had when the
+# daemon was FIRST started -- potentially minutes and many directory changes
+# ago, and possibly containing repository-local stubs (an `agent-vcs-refuse`
+# shim, a worktree bin/ directory, a lane's tool directory). `direnv export`
+# emits an absolute PATH snapshot, so whatever the child saw is what every
+# later shell gets applied.
+#
+# Publishing the caller's PATH here and handing it to the daemon lets the
+# `direnv export` child run on a stub-free PATH. The stubs must not leak into
+# the repository environment: they are per-checkout tools that are meaningful
+# only inside their own checkout.
+_direnv_instant_capture_caller_path() {
+  export DIRENV_INSTANT_CALLER_PATH="$PATH"
+}
