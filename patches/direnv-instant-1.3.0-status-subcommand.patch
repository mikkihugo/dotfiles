+/// Print one plain line to stdout.
+///
+/// Used by the `status` subcommand, whose output is a machine-readable
+/// `key=value` report rather than shell code. It goes to stdout unwrapped so
+/// a caller can parse it without evaluating anything.
+pub fn emit_line(line: &str) {
+    let _ = writeln!(std::io::stdout(), "{}", line);
+}
