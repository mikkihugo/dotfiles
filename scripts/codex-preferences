#!/usr/bin/env python3
import argparse
import re
import sys
import tomllib
from pathlib import Path

SHARED_KEYS = [
    "model",
    "model_provider",
    "model_reasoning_effort",
    "model_reasoning_summary",
    "web_search",
    # Codex truncates AGENTS.md at 32 KiB by default (measured: a 89,970-byte
    # AGENTS.md was cut at exactly 32 KiB). Several repos here exceed that, so
    # this must be shared to every machine, not just set locally.
    "project_doc_max_bytes",
    "tool_output_token_limit",
]
# Section-scoped shared keys. ~/.codex/config.toml is mutable and rewritten by
# Codex itself, so anything that must survive a Codex write has to be re-applied
# here on every activation rather than seeded once.
SHARED_SECTION_KEYS = {
    "tui": ["status_line"],
    # Codex's own on-disk memory store stays off: durable agent memory belongs
    # in the repo_memory bank, not a per-client store no other tool can read.
    "features": ["memories", "context_management", "step_model_switching", "mcp_2026_07_28"],
    "memories": ["use_memories", "generate_memories"],
}

# Retained for callers that still refer to the tui-only list.
SHARED_TUI_KEYS = SHARED_SECTION_KEYS["tui"]


def load_toml(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def save(args) -> None:
    source = Path(args.source).expanduser()
    target = Path(args.target).expanduser()
    data = load_toml(source)
    prefs = {key: data[key] for key in SHARED_KEYS if key in data}
    section_prefs = {}
    for section, keys in SHARED_SECTION_KEYS.items():
        source_section = data.get(section, {})
        picked = {key: source_section[key] for key in keys if key in source_section}
        if picked:
            section_prefs[section] = picked

    target.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Shared Codex client preferences.",
        "# Update from a machine with: codex-preferences save",
        "# Applied to each machine by Home Manager activation.",
        "",
    ]
    lines.extend(f"{key} = {toml_value(prefs[key])}" for key in SHARED_KEYS if key in prefs)
    for section, picked in section_prefs.items():
        lines.extend(["", f"[{section}]"])
        lines.extend(f"{key} = {toml_value(picked[key])}" for key in SHARED_SECTION_KEYS[section] if key in picked)
    target.write_text("\n".join(lines).rstrip() + "\n")

    saved = list(prefs) + [
        f"{section}.{key}" for section, picked in section_prefs.items() for key in picked
    ]
    if saved:
        print(f"saved {', '.join(saved)} to {target}")
    else:
        print(f"no shared Codex preferences found in {source}", file=sys.stderr)
        sys.exit(1)


def apply(args) -> None:
    source = Path(args.source).expanduser()
    target = Path(args.target).expanduser()
    prefs = {key: value for key, value in load_toml(source).items() if key in SHARED_KEYS}
    source_data = load_toml(source)
    section_prefs = {}
    for section, keys in SHARED_SECTION_KEYS.items():
        source_section = source_data.get(section, {})
        picked = {key: source_section[key] for key in keys if key in source_section}
        if picked:
            section_prefs[section] = picked
    if not prefs and not section_prefs:
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    original = target.read_text().splitlines() if target.exists() else []
    seen = set()
    seen_section = {section: set() for section in section_prefs}
    output = []
    top_level_key = re.compile(r"^([A-Za-z0-9_]+)\s*=")
    section_header = re.compile(r"^\s*\[([^]]+)]\s*$")
    section = None

    def flush_section(name):
        """Append any managed key the section declared but never contained."""
        if name not in section_prefs:
            return
        picked = section_prefs[name]
        for key in SHARED_SECTION_KEYS[name]:
            if key in picked and key not in seen_section[name]:
                output.append(f"{key} = {toml_value(picked[key])}")
                seen_section[name].add(key)

    for line in original:
        section_match = section_header.match(line)
        if section_match:
            flush_section(section)
            section = section_match.group(1)
        match = top_level_key.match(line)
        if section is None and match and match.group(1) in prefs:
            key = match.group(1)
            output.append(f"{key} = {toml_value(prefs[key])}")
            seen.add(key)
        elif section in section_prefs and match and match.group(1) in section_prefs[section]:
            key = match.group(1)
            output.append(f"{key} = {toml_value(section_prefs[section][key])}")
            seen_section[section].add(key)
        else:
            output.append(line)

    flush_section(section)

    missing = [key for key in SHARED_KEYS if key in prefs and key not in seen]
    if missing:
        insert = [f"{key} = {toml_value(prefs[key])}" for key in missing]
        output = insert + ([""] if output and output[0] else []) + output

    for name, picked in section_prefs.items():
        missing = [key for key in SHARED_SECTION_KEYS[name] if key in picked and key not in seen_section[name]]
        if not missing:
            continue
        if output and output[-1]:
            output.append("")
        output.append(f"[{name}]")
        output.extend(f"{key} = {toml_value(picked[key])}" for key in missing)

    target.write_text("\n".join(output).rstrip() + "\n")


def main() -> None:
    home = Path.home()
    default_live = home / ".codex/config.toml"
    default_shared = home / ".dotfiles/config/codex/shared-preferences.toml"

    parser = argparse.ArgumentParser(description="Sync shared Codex client preferences.")
    sub = parser.add_subparsers(dest="command", required=True)

    save_parser = sub.add_parser("save", help="copy whitelisted preferences from live Codex config to dotfiles")
    save_parser.add_argument("--source", default=str(default_live))
    save_parser.add_argument("--target", default=str(default_shared))
    save_parser.set_defaults(func=save)

    apply_parser = sub.add_parser("apply", help="apply shared dotfiles preferences to live Codex config")
    apply_parser.add_argument("--source", default=str(default_shared))
    apply_parser.add_argument("--target", default=str(default_live))
    apply_parser.set_defaults(func=apply)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
