#!/usr/bin/env python3
import argparse
import re
import sys
import tomllib
from pathlib import Path

SHARED_KEYS = [
    "model",
    "model_provider",
    "model_reasoning_effort",
    "model_reasoning_summary",
    "web_search",
    "developer_instructions",
    # Codex truncates AGENTS.md at 32 KiB by default (measured: a 89,970-byte
    # AGENTS.md was cut at exactly 32 KiB). Several repos here exceed that, so
    # this must be shared to every machine, not just set locally.
    "project_doc_max_bytes",
    "tool_output_token_limit",
]
# Section-scoped shared keys. ~/.codex/config.toml is mutable and rewritten by
# Codex itself, so anything that must survive a Codex write has to be re-applied
# here on every activation rather than seeded once.
SAVE_SECTION_KEYS = {
    "tui": ["status_line"],
    # Codex's own on-disk memory store stays off: durable agent memory belongs
    # in the repo_memory bank, not a per-client store no other tool can read.
    "features": ["memories", "context_management", "step_model_switching", "mcp_2026_07_28"],
    "memories": ["use_memories", "generate_memories"],
}
# These role registrations are declarative shared source, unlike the mutable
# live preferences collected by `save`. Keep them source-owned on save, then
# reapply them verbatim during activation so a local Codex rewrite cannot drift
# the fleet's role contract.
SHARED_AGENT_NAMES = ("scout", "implementer", "reviewer")

# Role registration is declarative policy. Activation applies it, but the
# operator-facing save command must never promote mutable live role drift back
# into the tracked shared-preferences source.
APPLY_SECTION_KEYS = {
    **SAVE_SECTION_KEYS,
    # OTLP routing is host policy. Apply it on every activation because Codex
    # owns and may rewrite its mutable live config; do not import it on `save`.
    "otel": ["environment", "log_user_prompt", "exporter", "trace_exporter"],
    "agents.scout": ["description", "config_file"],
    "agents.implementer": ["description", "config_file"],
    "agents.reviewer": ["description", "config_file"],
}

# Retained for callers that still refer to the tui-only list.
SHARED_TUI_KEYS = SAVE_SECTION_KEYS["tui"]


def load_toml(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as f:
        return tomllib.load(f)


def section_data(data: dict, section: str) -> dict:
    """Resolve a TOML section name without flattening unrelated sections."""
    value = data
    for component in section.split("."):
        value = value.get(component, {}) if isinstance(value, dict) else {}
    return value if isinstance(value, dict) else {}


def merge_preference_value(current, managed):
    """Overlay managed nested fields without discarding local credentials."""
    if isinstance(current, dict) and isinstance(managed, dict):
        return {
            key: merge_preference_value(current[key], value) if key in current else value
            for key, value in {**current, **managed}.items()
        }
    return managed


def toml_key(key) -> str:
    text = str(key)
    return text if re.fullmatch(r"[A-Za-z0-9_-]+", text) else toml_value(text)


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(f"{toml_key(key)} = {toml_value(item)}" for key, item in value.items()) + "}"
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


def shared_agent_preferences(data: dict) -> dict:
    agents = data.get("agents", {})
    if not isinstance(agents, dict):
        return {}
    return {name: agents[name] for name in SHARED_AGENT_NAMES if isinstance(agents.get(name), dict)}


def render_agent_section(name: str, values: dict) -> list[str]:
    return [f"[agents.{name}]", *(f"{key} = {toml_value(value)}" for key, value in values.items())]


def save(args) -> None:
    source = Path(args.source).expanduser()
    target = Path(args.target).expanduser()
    data = load_toml(source)
    target_data = load_toml(target)
    prefs = {key: data[key] for key in SHARED_KEYS if key in data}
    agent_prefs = shared_agent_preferences(target_data)
    section_prefs = {}
    for section, keys in SAVE_SECTION_KEYS.items():
        source_section = section_data(data, section)
        picked = {key: source_section[key] for key in keys if key in source_section}
        if picked:
            section_prefs[section] = picked

    target.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Shared Codex client preferences.",
        "# Update from a machine with: codex-preferences save",
        "# Applied to each machine by Home Manager activation.",
        "",
    ]
    lines.extend(f"{key} = {toml_value(prefs[key])}" for key in SHARED_KEYS if key in prefs)
    for section, picked in section_prefs.items():
        lines.extend(["", f"[{section}]"])
        lines.extend(f"{key} = {toml_value(picked[key])}" for key in SAVE_SECTION_KEYS[section] if key in picked)
    for name, values in agent_prefs.items():
        lines.extend(["", *render_agent_section(name, values)])
    target.write_text("\n".join(lines).rstrip() + "\n")

    saved = list(prefs) + [
        f"{section}.{key}" for section, picked in section_prefs.items() for key in picked
    ]
    if saved:
        print(f"saved {', '.join(saved)} to {target}")
    else:
        print(f"no shared Codex preferences found in {source}", file=sys.stderr)
        sys.exit(1)


def apply(args) -> None:
    source = Path(args.source).expanduser()
    target = Path(args.target).expanduser()
    prefs = {key: value for key, value in load_toml(source).items() if key in SHARED_KEYS}
    source_data = load_toml(source)
    target_data = load_toml(target)
    section_prefs = {}
    for section, keys in APPLY_SECTION_KEYS.items():
        source_section = section_data(source_data, section)
        target_section = section_data(target_data, section)
        picked = {
            key: merge_preference_value(target_section.get(key), source_section[key])
            for key in keys
            if key in source_section
        }
        if picked:
            section_prefs[section] = picked
    agent_prefs = shared_agent_preferences(source_data)
    if not prefs and not section_prefs and not agent_prefs:
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    original = target.read_text().splitlines() if target.exists() else []
    seen = set()
    seen_section = {section: set() for section in section_prefs}
    output = []
    top_level_key = re.compile(r"^([A-Za-z0-9_]+)\s*=")
    section_header = re.compile(r"^\s*\[([^]]+)]\s*$")
    section = None
    skipped_agent_section = None
    seen_agents = set()

    def flush_section(name):
        """Append any managed key the section declared but never contained."""
        if name not in section_prefs:
            return
        picked = section_prefs[name]
        for key in APPLY_SECTION_KEYS[name]:
            if key in picked and key not in seen_section[name]:
                output.append(f"{key} = {toml_value(picked[key])}")
                seen_section[name].add(key)

    for line in original:
        section_match = section_header.match(line)
        if section_match:
            flush_section(section)
            section = section_match.group(1)
            if section.startswith("agents.") and section.removeprefix("agents.") in agent_prefs:
                name = section.removeprefix("agents.")
                output.extend(render_agent_section(name, agent_prefs[name]))
                seen_agents.add(name)
                seen_section[section].update(agent_prefs[name])
                skipped_agent_section = name
                continue
            skipped_agent_section = None
        if skipped_agent_section is not None:
            continue
        match = top_level_key.match(line)
        if section is None and match and match.group(1) in prefs:
            key = match.group(1)
            output.append(f"{key} = {toml_value(prefs[key])}")
            seen.add(key)
        elif section in section_prefs and match and match.group(1) in section_prefs[section]:
            key = match.group(1)
            output.append(f"{key} = {toml_value(section_prefs[section][key])}")
            seen_section[section].add(key)
        else:
            output.append(line)

    flush_section(section)

    missing = [key for key in SHARED_KEYS if key in prefs and key not in seen]
    if missing:
        insert = [f"{key} = {toml_value(prefs[key])}" for key in missing]
        output = insert + ([""] if output and output[0] else []) + output

    for name, picked in section_prefs.items():
        if name.startswith("agents.") and name.removeprefix("agents.") in agent_prefs:
            continue
        missing = [key for key in APPLY_SECTION_KEYS[name] if key in picked and key not in seen_section[name]]
        if not missing:
            continue
        if output and output[-1]:
            output.append("")
        output.append(f"[{name}]")
        output.extend(f"{key} = {toml_value(picked[key])}" for key in missing)

    for name, values in agent_prefs.items():
        if name in seen_agents:
            continue
        if output and output[-1]:
            output.append("")
        output.extend(render_agent_section(name, values))

    target.write_text("\n".join(output).rstrip() + "\n")


def main() -> None:
    home = Path.home()
    default_live = home / ".codex/config.toml"
    default_shared = home / ".dotfiles/config/codex/shared-preferences.toml"

    parser = argparse.ArgumentParser(description="Sync shared Codex client preferences.")
    sub = parser.add_subparsers(dest="command", required=True)

    save_parser = sub.add_parser("save", help="copy whitelisted preferences from live Codex config to dotfiles")
    save_parser.add_argument("--source", default=str(default_live))
    save_parser.add_argument("--target", default=str(default_shared))
    save_parser.set_defaults(func=save)

    apply_parser = sub.add_parser("apply", help="apply shared dotfiles preferences to live Codex config")
    apply_parser.add_argument("--source", default=str(default_shared))
    apply_parser.add_argument("--target", default=str(default_live))
    apply_parser.set_defaults(func=apply)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
