#!/usr/bin/env bash
# git credential helper for https://git.centralcloud.net backed by OpenBao.
#
# Purpose: give plain `git` over HTTPS the Forgejo token without ever storing it
#   in a git config file. The token is read from kv/forgejo/cli-mhugo (field
#   `token`) at call time and written only to git's stdout pipe.
# Consumer: git, via home/modules/git.nix
#   (credential."https://git.centralcloud.net".helper).
# Contract: `get` for protocol=https host=git.centralcloud.net prints
#   username=mhugo and password=<token>. Every other host, protocol or action
#   (`store`, `erase`) prints nothing and does not call bao. Any bao failure or
#   empty token prints nothing and exits 0, so git falls through instead of
#   hanging; the token is never written to stderr or argv.
# Falsifier: scripts/test-git-credential-forgejo-bao.sh.
set -euo pipefail

action="${1:-}"
[[ "$action" == get ]] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
	case "$key" in
	protocol) protocol="$value" ;;
	host) host="$value" ;;
	esac
done

[[ "$protocol" == https && "$host" == git.centralcloud.net ]] || exit 0

export BAO_ADDR="${BAO_ADDR:-http://vault-active.vault.svc.cluster.local:8200}"
if ! token="$("${BAO_BIN:-bao}" kv get -mount=kv -field=token forgejo/cli-mhugo 2>/dev/null)"; then
	echo 'git-credential-forgejo-bao: could not read kv/forgejo/cli-mhugo from OpenBao (run bao-login?)' >&2
	exit 0
fi
[[ -n "$token" ]] || exit 0

printf 'username=mhugo\npassword=%s\n' "$token"
