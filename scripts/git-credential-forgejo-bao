#!/usr/bin/env bash
# git credential helper for https://git.centralcloud.net backed by OpenBao.
#
# Purpose: give plain `git` over HTTPS the Forgejo token without ever storing it
#   in a git config file. The token is read from kv/forgejo/cli-mhugo (field
#   `token`) at call time and written only to git's stdout pipe.
# Consumer: git, via home/modules/git.nix
#   (credential."https://git.centralcloud.net".helper).
# Contract: `get` for protocol=https host=git.centralcloud.net prints
#   username=mhugo and password=<token>. Every other host, protocol or action
#   (`store`, `erase`) prints nothing and does not call bao. Any bao failure or
#   empty token prints nothing and exits 0, so git falls through instead of
#   hanging; the token is never written to stderr or argv.
# Falsifier: scripts/test-git-credential-forgejo-bao.sh.
#
# Token sources, in order:
#   1. OpenBao kv/forgejo/cli-mhugo (canonical, read at call time).
#   2. The rendered copy of the same secret: $FORGEJO_TOKEN_FILE, then
#      ~/.config/forgejo/token. scripts/forgejo-token-sync (the
#      forgejo-token-file unit) materialises these from OpenBao. The copy is
#      the fallback for an OpenBao that cannot be reached — the host's
#      cluster DNS was down while every Forgejo HTTPS push failed with
#      "Credentials are incorrect or have expired" even though a valid token
#      sat on disk. A copy that is group- or world-readable is refused: the
#      operator's own Forgejo client refuses those files, and so must this.
set -euo pipefail

action="${1:-}"
[[ "$action" == get ]] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
	case "$key" in
	protocol) protocol="$value" ;;
	host) host="$value" ;;
	esac
done

[[ "$protocol" == https && "$host" == git.centralcloud.net ]] || exit 0

# Read one owner-only token file. Prints the token, or nothing.
token_from_copy() {
	local file mode
	for file in "${FORGEJO_TOKEN_FILE:-}" "$HOME/.config/forgejo/token"; do
		[[ -n "$file" && -f "$file" && -r "$file" ]] || continue
		mode="$(stat -c '%a' "$file" 2>/dev/null || printf '000')"
		# Refuse anything readable by group or other: mode & 077 must be 0.
		if (( 0${mode} & 077 )); then
			continue
		fi
		head -c 4096 "$file" 2>/dev/null | tr -d '\n'
		return 0
	done
}

export BAO_ADDR="${BAO_ADDR:-http://vault-active.vault.svc.cluster.local:8200}"
token=""
if ! token="$("${BAO_BIN:-bao}" kv get -mount=kv -field=token forgejo/cli-mhugo 2>/dev/null)"; then
	echo 'git-credential-forgejo-bao: could not read kv/forgejo/cli-mhugo from OpenBao (run bao-login?)' >&2
	token=""
fi
if [[ -z "$token" ]]; then
	token="$(token_from_copy)"
fi
[[ -n "$token" ]] || exit 0

printf 'username=mhugo\npassword=%s\n' "$token"
