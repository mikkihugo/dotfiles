#!/usr/bin/env python3
"""Apply the Home Manager-owned J-Code provider preferences without replacing UI state."""

import argparse
import os
import re
import stat
import tempfile
import tomllib
from pathlib import Path


MANAGED_SECTIONS = ("provider", "auth", "features", "agents")
MANAGED_PROFILES = ("llm-gateway", "minimax-direct", "ollama-cloud", "byteplus-ark")
SECTION_HEADER = re.compile(r"^\s*(\[\[?)([^\]]+)(\]\]?)\s*(?:#.*)?$")
KEY = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")


def load_toml(path: Path, *, allow_missing: bool = False) -> dict:
    if allow_missing and not path.exists():
        return {}
    with path.open("rb") as stream:
        return tomllib.load(stream)


def toml_value(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int | float):
        return str(value)
    if isinstance(value, str):
        return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
    if isinstance(value, list) and all(not isinstance(item, dict) for item in value):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    raise ValueError(f"unsupported TOML preference value: {value!r}")


def managed_source(path: Path) -> tuple[dict[str, dict], dict[str, dict]]:
    data = load_toml(path)
    sections: dict[str, dict] = {}
    for name in MANAGED_SECTIONS:
        value = data.get(name, {})
        if not isinstance(value, dict):
            raise ValueError(f"[{name}] must be a TOML table")
        sections[name] = value

    providers = data.get("providers")
    if not isinstance(providers, dict):
        raise ValueError("[providers] must contain the managed provider profiles")
    profiles: dict[str, dict] = {}
    for name in MANAGED_PROFILES:
        value = providers.get(name)
        if not isinstance(value, dict):
            raise ValueError(f"[providers.{name}] is required")
        profiles[name] = value
    return sections, profiles


def chunks(lines: list[str]) -> list[tuple[str | None, list[str]]]:
    result: list[tuple[str | None, list[str]]] = []
    current_name: str | None = None
    current: list[str] = []
    # A line inside an open value can look exactly like a section header --
    # `    ["c"]` in a nested array matches SECTION_HEADER -- so only split when
    # no value is still open, or the section tail is torn off mid-array.
    depth = 0
    open_delim = ""
    for line in lines:
        if depth <= 0 and not open_delim:
            match = SECTION_HEADER.match(line)
            if match:
                result.append((current_name, current))
                current_name = match.group(2).strip()
                current = [line]
                continue
            current.append(line)
            if KEY.match(line):
                depth, open_delim = scan_value(line.split("=", 1)[1])
            continue
        current.append(line)
        depth, open_delim = scan_value(line, depth, open_delim)
    result.append((current_name, current))
    return result


def scan_value(fragment: str, depth: int = 0, open_delim: str = "") -> tuple[int, str]:
    """Track how far through a TOML value a fragment gets.

    Returns the net `[`/`{` nesting plus the multi-line string delimiter still
    open at the end of the fragment. Brackets inside a quoted string, inside a
    multi-line string body, or after an unquoted `#` do not count, so
    `["a]b", "c"]  # note` closes on its own line while an opened `'''` does not.
    """
    index = 0
    quote = ""
    while index < len(fragment):
        if open_delim:
            end = fragment.find(open_delim, index)
            if end == -1:
                return depth, open_delim
            index = end + len(open_delim)
            open_delim = ""
            continue
        rest = fragment[index:]
        if not quote and (rest[:3] == '"""' or rest[:3] == "'''"):
            open_delim = rest[:3]
            index += 3
            continue
        char = fragment[index]
        if quote:
            if char == "\\" and quote == '"':
                index += 2
                continue
            if char == quote:
                quote = ""
        elif char in "\"'":
            quote = char
        elif char == "#":
            break
        elif char in "[{":
            depth += 1
        elif char in "]}":
            depth -= 1
        index += 1
    return max(depth, 0), open_delim


def patch_section(chunk: list[str], values: dict) -> list[str]:
    output = [chunk[0]]
    seen: set[str] = set()
    # J-Code writes long arrays across several lines, and a user may keep a
    # multi-line string here. A managed key must have its whole value consumed,
    # or the continuation lines survive the replacement and the rendered file is
    # no longer valid TOML. Conversely a line inside someone else's multi-line
    # string is prose, never a key -- rewriting it would silently edit their text.
    depth = 0
    open_delim = ""
    dropping = False
    for line in chunk[1:]:
        if depth > 0 or open_delim:
            depth, open_delim = scan_value(line, depth, open_delim)
            if not dropping:
                output.append(line)
            continue
        match = KEY.match(line)
        key = match.group(1) if match else None
        if key is None:
            output.append(line)
            continue
        depth, open_delim = scan_value(line.split("=", 1)[1])
        dropping = key in values
        if dropping:
            if key not in seen:
                output.append(f"{key} = {toml_value(values[key])}")
                seen.add(key)
            continue
        output.append(line)
    if depth > 0 or open_delim:
        raise ValueError(f"unterminated value in section {chunk[0].strip()}; refusing to rewrite it")
    output.extend(f"{key} = {toml_value(values[key])}" for key in values if key not in seen)
    return output


def render_profile(name: str, profile: dict) -> list[str]:
    root = f"providers.{name}"
    scalar_items = []
    nested_tables: list[tuple[str, dict]] = []
    array_tables: list[tuple[str, list[dict]]] = []
    for key, value in profile.items():
        if isinstance(value, dict):
            nested_tables.append((key, value))
        elif isinstance(value, list) and all(isinstance(item, dict) for item in value):
            array_tables.append((key, value))
        else:
            scalar_items.append((key, value))

    output = [f"[{root}]"]
    output.extend(f"{key} = {toml_value(value)}" for key, value in scalar_items)
    for key, values in nested_tables:
        output.extend(["", f"[{root}.{key}]"])
        output.extend(f"{nested_key} = {toml_value(nested_value)}" for nested_key, nested_value in values.items())
    for key, entries in array_tables:
        for entry in entries:
            output.extend(["", f"[[{root}.{key}]]"])
            output.extend(f"{nested_key} = {toml_value(nested_value)}" for nested_key, nested_value in entry.items())
    return output


def is_managed_profile(name: str | None) -> bool:
    if name is None:
        return False
    return any(name == f"providers.{profile}" or name.startswith(f"providers.{profile}.") for profile in MANAGED_PROFILES)


def apply_preferences(source: Path, target: Path) -> None:
    section_values, profiles = managed_source(source)
    # Parse before touching the target so malformed user configuration is never overwritten.
    load_toml(target, allow_missing=True)

    original = target.read_text() if target.exists() else ""
    output: list[str] = []
    seen_sections: set[str] = set()
    profile_inserted = False
    profile_block = [line for name in MANAGED_PROFILES for line in ([""] if name != MANAGED_PROFILES[0] else []) + render_profile(name, profiles[name])]

    for name, chunk in chunks(original.splitlines()):
        if is_managed_profile(name):
            if not profile_inserted:
                if output and output[-1]:
                    output.append("")
                output.extend(profile_block)
                profile_inserted = True
            continue
        if name in section_values:
            output.extend(patch_section(chunk, section_values[name]))
            seen_sections.add(name)
        else:
            output.extend(chunk)

    for name in MANAGED_SECTIONS:
        if name not in seen_sections:
            if output and output[-1]:
                output.append("")
            output.append(f"[{name}]")
            output.extend(f"{key} = {toml_value(value)}" for key, value in section_values[name].items())

    if not profile_inserted:
        if output and output[-1]:
            output.append("")
        output.extend(profile_block)

    rendered = "\n".join(output).rstrip() + "\n"
    tomllib.loads(rendered)
    target.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else 0o600
    with tempfile.NamedTemporaryFile("w", dir=target.parent, prefix=f".{target.name}.", delete=False) as temporary:
        temporary.write(rendered)
        temporary.flush()
        os.fsync(temporary.fileno())
        temporary_path = Path(temporary.name)
    try:
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, target)
    finally:
        temporary_path.unlink(missing_ok=True)


def main() -> None:
    home = Path.home()
    parser = argparse.ArgumentParser(description="Apply Home Manager-owned J-Code provider preferences.")
    subcommands = parser.add_subparsers(dest="command", required=True)
    apply = subcommands.add_parser("apply")
    apply.add_argument("--source", default=str(home / ".dotfiles/config/jcode/shared-preferences.toml"))
    apply.add_argument("--target", default=str(home / ".jcode/config.toml"))
    args = parser.parse_args()
    if args.command == "apply":
        apply_preferences(Path(args.source).expanduser(), Path(args.target).expanduser())


if __name__ == "__main__":
    main()
