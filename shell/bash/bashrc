# Kubernetes context helpers. kubectx/kubens read KUBECONFIG, which Home
# Manager sets to ~/.kube/config.
kctxf() {
	local selected
	selected="$(kubectx | fzf --height=40% --reverse --prompt='kubectx> ')" || return
	[ -n "$selected" ] && kubectx "$selected"
}

knsf() {
	local selected
	selected="$(kubens | fzf --height=40% --reverse --prompt='kubens> ')" || return
	[ -n "$selected" ] && kubens "$selected"
}

# Eager load — makes keys available to child processes (Claude Code, Cursor, CI)
# without requiring a manual `load-ai-keys` invocation.
_load_sops_secrets 2>/dev/null || true

# CentralCloud OTLP for coding CLIs (collector in-cluster, else otel-ingest + Bao).
# shellcheck source=/dev/null
[ -f "$HOME/.dotfiles/shell/bash/otel-env.sh" ] && . "$HOME/.dotfiles/shell/bash/otel-env.sh"

# ── Non-interactive direnv export ────────────────────────────────────────────
# programs.direnv uses interactive prompt hooks. Agent/CI shells instead use a
# bounded enter-once loader that distinguishes the current repo from an
# inherited foreign Nix shell.
# shellcheck source=direnv-export.sh
# shellcheck disable=SC1091
[ -f "$HOME/.dotfiles/shell/bash/direnv-export.sh" ] &&
	. "$HOME/.dotfiles/shell/bash/direnv-export.sh"
