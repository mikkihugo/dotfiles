#!/usr/bin/env bash
# shell/bash/bashrc — runtime shell hooks that cannot live in Nix
#
# Purpose:
#   Only things that MUST eval in a live shell belong here:
#   - mise runtime activation (needs live eval per shell)
#   - _load_sops_secrets / load-ai-keys (SOPS needs the age key from the
#     running environment, not baked into the Nix closure)
#   - Non-interactive direnv export (programs.direnv uses PROMPT_COMMAND
#     which doesn't fire in non-interactive shells like Claude Code/CI)
#   - Runtime-only shell integration not managed by home-manager
#
#   Everything else — PATH, env vars, aliases, prompt, tool hooks (direnv
#   interactive, starship, zoxide) — is declared in home/home.nix and
#   applied by `home-manager switch` (alias: hms).
#
# Sourced by:
#   programs.bash.initExtra  (bash sessions)
#   programs.zsh.initContent (zsh sessions, POSIX-compatible subset)

# Set HOME if missing (safety guard for minimal environments)
[ -z "$HOME" ] && export HOME="/home/mhugo"

# ── TERM upgrade ──────────────────────────────────────────────────────────────
# mosh/Termius hand us a bare "xterm" (8-color), which caps colour in the TUI,
# jcode, ls, etc. even though the emulator is truecolor-capable. Promote the
# plain xterm case to 256-colour. Only the exact "xterm" value is touched, so
# an intentional TERM=dumb (agent/CI) and already-rich values are left alone.
[ "$TERM" = "xterm" ] && export TERM=xterm-256color

# ── jcode in a persistent tmux session ────────────────────────────────────────
# `jc` launches jcode inside a tmux session named "jcode" so the TUI survives
# SSH/mosh disconnects; run `jc` again (or `jca`) to reattach. jcode's own
# daemon already keeps the agent running when the TUI drops — this just keeps
# the view+scrollback too. Full path dodges any PATH/hash staleness.
jc() {
	if ! systemctl --user is-active --quiet jcode-server.service; then
		echo "jc: managed jcode-server.service is not active; refusing standalone server auto-start" >&2
		return 78
	fi
	export JCODE_SOCKET="${JCODE_SOCKET:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/jcode.sock}"
	if [ -n "${TMUX:-}" ]; then
		"$HOME/.local/bin/jcode" "$@"
	else
		tmux new-session -A -s jcode "$HOME/.local/bin/jcode" "$@"
	fi
}
jca() { tmux attach -t jcode; }

# ── Mise (polyglot runtime version manager) ───────────────────────────────────
# Must be activated per-shell so the shims and hooks are wired up.
# Detect zsh vs bash so the right integration is loaded.
mise_bin="$(command -v mise 2>/dev/null || true)"
if [ -n "$mise_bin" ]; then
	# mise activate installs shell completion (complete -F …). Non-interactive
	# shells (direnv export, CI, agent Shell) source this file without
	# bash-completion, which yields "complete: command not found".
	if [ -n "${ZSH_VERSION:-}" ]; then
		if [[ $- == *i* ]]; then
			eval "$("$mise_bin" activate zsh)"
		else
			eval "$("$mise_bin" env -s zsh)"
		fi
	elif [[ $- == *i* ]]; then
		eval "$("$mise_bin" activate bash)"
	else
		eval "$("$mise_bin" env -s bash)"
	fi

	# mise activate prepends tool install dirs ahead of home.sessionPath, which
	# shadows HM wrappers in ~/.local/bin (goose → llm-gateway, kimi, …).
	export PATH="$HOME/.local/bin:$PATH"
fi
unset mise_bin

# Non-interactive/agent shells skip ~/.bashrc (HM's `[[ $- == *i* ]] || return`),
# so they miss the wrapper-precedence restore above and run raw mise binaries
# instead of the llm-gateway wrappers. Export BASH_ENV so every non-interactive
# child bash sources the shared PATH + direnv enter-once loader.
if [ -f "$HOME/.dotfiles/shell/bash/noninteractive-path.sh" ]; then
	export BASH_ENV="$HOME/.dotfiles/shell/bash/noninteractive-path.sh"
fi

# ── SOPS on-demand secret loader ─────────────────────────────────────────────
# Decrypts ~/.dotfiles/secrets/api-keys.yaml and exports LLM API credentials.
# Called eagerly below (silent, non-fatal) so keys are available to child
# processes without a manual `load-ai-keys` invocation.
_load_sops_secrets() {
	# Never trace this function. xtrace prints every command with its arguments
	# already expanded, so a caller's `set -x` writes out both every exported key
	# and -- via the `echo "$decrypted"` helpers below, which pipe the WHOLE
	# decrypted file -- the entire api-keys.yaml, once per lookup. That is how a
	# debugging session leaked ~20 API keys and 33 private-key blocks at once.
	#
	# `local -` (bash) and `setopt localoptions` (zsh) restore the caller's option
	# set on return, including the early `return 1` paths, so this cannot leave
	# xtrace off behind our back. Do NOT drop the BASH_VERSION guard: in zsh a
	# bare `local -` is `typeset -` with no names, which DUMPS EVERY PARAMETER
	# WITH ITS VALUE -- that exact mistake leaked live keys while this fix was
	# being written. Both files are also sourced from programs.zsh.initContent.
	# In a shell that is neither bash nor zsh only `set +x` runs and the caller's
	# xtrace stays off; that is the safe direction, and this file is only ever
	# sourced from the bash and zsh init paths.
	[ -n "${BASH_VERSION:-}" ] && local -
	[ -n "${ZSH_VERSION:-}" ] && setopt localoptions
	set +x

	local secrets_file="$HOME/.dotfiles/secrets/api-keys.yaml"

	if [[ ! -f "$secrets_file" ]]; then
		echo "load-ai-keys: $secrets_file not found" >&2
		return 1
	fi
	if ! command -v sops >/dev/null 2>&1; then
		echo "load-ai-keys: sops not in PATH" >&2
		return 1
	fi

	local decrypted
	decrypted=$(sops --decrypt "$secrets_file" 2>/dev/null) || {
		echo "load-ai-keys: sops decrypt failed (check age key at ${SOPS_AGE_KEY_FILE:-~/.config/sops/age/keys.txt})" >&2
		return 1
	}

	# Helper: extract value under a YAML section (searches up to 5 children)
	# Strip inline YAML comments: a value may carry a trailing "# pragma: allowlist
	# secret", which is metadata for the secret scanner, not part of the secret.
	_sops_val() { echo "$decrypted" | grep -A5 "^$1:" | grep "$2:" | head -1 | sed "s/.*$2: *//;s/^ *//;s/ *$//" | sed 's/ *#.*$//' | tr -d '"'; }
	_sops_sf_val() { echo "$decrypted" | grep -A80 "^sf:" | grep "$1:" | head -1 | sed "s/.*$1: *//;s/^ *//;s/ *$//" | sed 's/ *#.*$//' | tr -d '"'; }

	# LLM Gateway (proxies all providers through a single endpoint)
	local val url
	val=$(_sops_val llm_gateway api_key)
	url=$(_sops_val llm_gateway base_url)
	if [ -n "$val" ] && [ -n "$url" ]; then
		export LLM_MUX_API_KEY="$val"
		export LLM_MUX_BASE_URL="$url"

		# Copilot CLI BYOK: point it at the same gateway. Without these,
		# copilot only offers GitHub-native models and every gateway alias
		# (auto-minimax, auto-glm, auto-kimi, ollama-*) is unresolvable --
		# including the ones ~/.copilot/settings.json assigns to subagents.
		#
		# Keep /v1 while COPILOT_PROVIDER_TYPE is openai (Copilot 1.0.84
		# looks up models at {base}/...; stripping /v1 404s auto-minimax).
		# Measured 2026-09-15:
		#   COPILOT_PROVIDER_BASE_URL without /v1 -> Model not found HTTP 404
		#   .../v1 + auto-minimax                 -> copilot -p pong works
		# Anthropic used to need a bare root (/v1/v1/messages). TYPE is openai
		# now, so the OpenAI-shaped URL (LLM_MUX_BASE_URL, with /v1) is correct.
		# LLM_MUX_BASE_URL keeps /v1 for OpenAI consumers.
		export COPILOT_PROVIDER_BASE_URL="$url"
		export COPILOT_PROVIDER_API_KEY="$val"

		# Anthropic wire, not the "openai" default: auto-minimax's only gateway
		# deployment is protocol: anthropic_messages (MiniMax's native Anthropic
		# Messages endpoint). With the openai default, every request gets a real
		# OpenAI-chat -> Anthropic-Messages payload conversion
		# (chat_request_to_anthropic_messages in gateway-protocol-anthropic)
		# before it reaches MiniMax -- avoidable, since MiniMax also natively
		# supports OpenAI chat completions, but the gateway doesn't yet expose a
		# second protocol:openai_chat_completions deployment for it (tracked
		# separately). Anthropic wire matches what's actually configured, so it
		# skips that conversion.
		export COPILOT_PROVIDER_TYPE="openai"

		# BYOK also needs an explicit model or copilot refuses to start:
		# "BYOK providers require an explicit model." The "model" key in
		# ~/.copilot/settings.json is NOT consulted on the BYOK path
		# (verified against 1.0.82 -- settings.json says "auto" and bare
		# copilot still errored). Default it here so plain `copilot` runs;
		# an inherited COPILOT_MODEL or --model still wins.
		#
		# Deliberately not "auto": the gateway's auto/auto-code aliases
		# currently resolve to a Kimi upstream that answers HTTP 403
		# "weekly (7-day) usage limit" -- which copilot misreports as
		# "Authentication failed ... check your COPILOT_PROVIDER_API_KEY".
		# auto-minimax is verified working end to end.
		export COPILOT_MODEL="${COPILOT_MODEL:-auto-minimax}"
		# Keep the BYOK identity and wire model explicit. Copilot 1.0.103
		# otherwise re-validates the gateway alias against its hosted catalog and
		# can replace it with claude-sonnet-5 during startup.
		export COPILOT_PROVIDER_MODEL_ID="${COPILOT_PROVIDER_MODEL_ID:-auto-minimax}"
		export COPILOT_PROVIDER_WIRE_MODEL="${COPILOT_PROVIDER_WIRE_MODEL:-auto-minimax}"

		# Alternate providers (Copilot CLI >= 1.0.103). The flag plus a second
		# model id lets the AGENT run a different model from the chat session,
		# both through this one gateway:
		#   COPILOT_ENABLE_ALT_PROVIDERS=true   opt-in flag (exact "true")
		#   COPILOT_AGENT_MODEL=<id>            model for agent/subagent calls
		#   COPILOT_MODEL=<id>                  model for the main session
		# 1.0.103 wires agentModel beside model in the same session config
		# (cli-main.js: altProvidersEnabled / agentModel / model), and on agent
		# continuation it switches with a distinct providerId and source:"agent".
		# Split: main sessions get auto-minimax (MiniMax-M3); agent/subagent
		# volume work gets auto-minimax-fast (MiniMax-M3.1-Flash). Both probed
		# HTTP 200 against the gateway 2026-10-23.
		# NOTE: these vars are absent from the 0.0.373 / 1.0.91-1 dists still
		# cached on this host, so an older resolved dist silently ignores them.
		# They are present from 1.0.92-4 onward (verified against the cached
		# ~/.copilot/pkg/linux-x64/*/cli-main.js bundles: 1.0.92-4, 1.0.103-0
		# and 1.0.103 all carry the same four env names).
		# Multimodel BYOK is the default: the explicit provider identity above
		# keeps Copilot 1.0.103 from replacing the main alias with Sonnet during
		# startup while the agent lane uses the fast gateway alias.
		export COPILOT_ENABLE_ALT_PROVIDERS=true
		export COPILOT_AGENT_MODEL=auto-minimax-fast

		# Pin the token budget. Copilot resolves limits as: manual env vars ->
		# built-in catalog -> defaults (see `copilot help providers`). Gateway
		# aliases are never in GitHub's built-in catalog, so without these it
		# warns "not in the built-in catalog" and silently uses generic
		# defaults -- throwing away most of the window.
		#
		# auto-minimax resolves to minimax-coding-plan/MiniMax-M3, whose upstream
		# declares protocol: anthropic_messages at api.minimax.io/anthropic/v1.
		# An OpenAI-shaped request is therefore CONVERTED; Anthropic ingress
		# matches the upstream and passes through natively, skipping that
		# conversion cost.
		# Note (post-#1332, kimi-c6cb190a live probe 2026-09-09T17:05Z): tools on
		# the chat wire are no longer stripped — /v1/chat/completions with
		# tools=[...] now returns well-formed tool_calls[0] (typed arguments,
		# real call id, finish_reason=tool_calls). The 2026-09-04 measurement
		# below was correct AT THE TIME and is kept for historical context;
		# Anthropic wire still wins where it fits because it avoids conversion.
		#     POST /v1/chat/completions -> tool_calls: None   (pre-#1332)
		#     POST /v1/messages         -> tool_use: well-formed (always)
		export COPILOT_PROVIDER_TYPE="${COPILOT_PROVIDER_TYPE:-openai}"
		# MiniMax publishes a 1M context but guarantees only 512K of it, so the
		# prompt cap stays inside the guarantee rather than the ceiling.
		# An earlier revision of this comment claimed prompt+output had to sum to
		# 524288. That constraint is imaginary - Copilot does not share one window
		# between them - but 448K remains a sound conservative choice.
		# Verified 2026-09-03: an 11001-token completion returned
		# finish_reason=stop, so output well past the 16384 default works.
		export COPILOT_PROVIDER_MAX_PROMPT_TOKENS="${COPILOT_PROVIDER_MAX_PROMPT_TOKENS:-458752}"
		export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS="${COPILOT_PROVIDER_MAX_OUTPUT_TOKENS:-65536}"
	fi

	# Copilot BYOK does not enumerate the provider catalogue, so /model cannot
	# list the gateway's aliases no matter what is configured. That is unchanged
	# in 1.0.103: no /v1/models call exists in the bundle. Its own help says so:
	# "A model is required for BYOK. Set COPILOT_MODEL, COPILOT_PROVIDER_MODEL_ID,
	# or --model."  A default is exported above; these switch model per invocation.
	#
	# SUPERSEDED NOTE (was: "BYOK is single-model by design in >=1.0.82").
	# Single-*endpoint* still holds -- one COPILOT_PROVIDER_BASE_URL. But
	# single-*model* did not hold from 1.0.103, which added
	# COPILOT_ENABLE_ALT_PROVIDERS + COPILOT_AGENT_MODEL to run a different model
	# for agent/subagent calls than for the main session, through that endpoint.
	copilot-minimax() { COPILOT_MODEL=auto-minimax command copilot "$@"; }
	copilot-glm() { COPILOT_MODEL=auto-glm command copilot "$@"; }
	copilot-kimi() { COPILOT_MODEL=auto-kimi command copilot "$@"; }
	copilot-fast() { COPILOT_MODEL=auto-fast command copilot "$@"; }
	copilot-auto() { COPILOT_MODEL=auto command copilot "$@"; }
	# Start Copilot on GitHub's built-in provider/model catalogue.  The normal
	# `copilot` entrypoint inherits the gateway BYOK variables loaded above;
	# unset them only for this child so the caller's shell remains unchanged.
	copilot-cp() {
		env \
			-u COPILOT_PROVIDER_BASE_URL \
			-u COPILOT_PROVIDER_API_KEY \
			-u COPILOT_PROVIDER_TYPE \
			-u COPILOT_PROVIDER_MODEL_ID \
			-u COPILOT_PROVIDER_WIRE_MODEL \
			-u COPILOT_PROVIDER_MAX_PROMPT_TOKENS \
			-u COPILOT_PROVIDER_MAX_OUTPUT_TOKENS \
			-u COPILOT_AGENT_MODEL \
			COPILOT_MODEL=auto \
			COPILOT_ENABLE_ALT_PROVIDERS=false \
			copilot "$@"
	}
	# Volume/cheap split: strong model for the session, flash model for agents.
	copilot-volume() {
		COPILOT_ENABLE_ALT_PROVIDERS=true COPILOT_MODEL=auto-minimax \
			COPILOT_AGENT_MODEL=auto-minimax-fast \
			command copilot "$@"
	}
	# Full-strength everywhere (disables the fast agent tier for this run).
	copilot-strong() {
		COPILOT_ENABLE_ALT_PROVIDERS=true COPILOT_MODEL=auto-minimax \
			COPILOT_AGENT_MODEL=auto-minimax \
			command copilot "$@"
	}

	# OpenAI Gateway (ACE Coder / Goose CLI)
	val=$(_sops_val openai_gateway api_key)
	url=$(_sops_val openai_gateway base_url)
	[ -n "$val" ] && export OPENAI_GATEWAY_API_KEY="$val"
	[ -n "$url" ] && export OPENAI_GATEWAY_BASE_URL="$url"

	# DeepSeek
	val=$(_sops_val deepseek api_key)
	[ -n "$val" ] && export DEEPSEEK_API_KEY="$val"

	# Kimi (Moonshot)
	val=$(_sops_val kimi api_key)
	[ -n "$val" ] && export KIMI_API_KEY="$val"
	val=$(_sops_val kimi code_api_key)
	[ -n "$val" ] && export KIMI_CODE_API_KEY="$val"

	# MiniMax
	val=$(_sops_val minimax api_key)
	[ -n "$val" ] && export MINIMAX_API_KEY="$val"

	# Cloudflare AI Gateway
	val=$(_sops_val cloudflare_ai_gateway aig_token)
	[ -n "$val" ] && export CF_AIG_TOKEN="$val"

	# OpenRouter — deliberately NOT exported. jcode's provider_keys_for_env
	# (external.rs:608) auto-detects the "openrouter" provider from
	# OPENROUTER_API_KEY; there is no jcode config switch to hide it, so keeping
	# the key out of the environment is the only way. Everything routes through
	# llm-gateway anyway. Re-enable only if a tool needs the direct key.
	# val=$(_sops_val openrouter api_key)
	# [ -n "$val" ] && export OPENROUTER_API_KEY="$val"

	# xAI (Grok)
	val=$(_sops_val xai api_key)
	[ -n "$val" ] && export XAI_API_KEY="$val"

	# Groq
	val=$(_sops_val groq api_key)
	[ -n "$val" ] && export GROQ_API_KEY="$val"

	# Longcat
	val=$(_sops_val longcat api_key)
	[ -n "$val" ] && export LONGCAT_API_KEY="$val"

	# ElevenLabs
	val=$(_sops_val elevenlabs api_key)
	[ -n "$val" ] && export ELEVENLABS_API_KEY="$val"
	val=$(_sops_val elevenlabs voice_id)
	[ -n "$val" ] && export ELEVENLABS_VOICE_ID="$val"

	# Hetzner
	val=$(_sops_val hetzner api_token)
	[ -n "$val" ] && export HETZNER_API_TOKEN="$val"

	# Cloudflare (Global API Key — flarectl + ad-hoc CF API; X-Auth-Email + X-Auth-Key)
	val=$(_sops_val cloudflare api_token)
	if [ -n "$val" ]; then
		export CF_API_KEY="$val"
		cf_api_email="$(_sops_val cloudflare email)"
		export CF_API_EMAIL="$cf_api_email"
		# Aliases some tools (Terraform CF provider, others) expect
		export CLOUDFLARE_API_KEY="$CF_API_KEY"
		export CLOUDFLARE_API_EMAIL="$CF_API_EMAIL"
		unset cf_api_email
	fi

	# gog Google Workspace CLI encrypted file keyring
	val=$(_sops_val gog keyring_password)
	[ -n "$val" ] && export GOG_KEYRING_PASSWORD="$val"

	# Exa (Web Search)
	val=$(_sops_val exa api_key)
	[ -n "$val" ] && export EXA_API_KEY="$val"

	# Tavily (Web Search — stored under sf section)
	val=$(_sops_sf_val TAVILY_API_KEY)
	[ -n "$val" ] && export TAVILY_API_KEY="$val"

	# Ollama Cloud
	val=$(_sops_val ollama_cloud api_key)
	[ -n "$val" ] && export OLLAMA_CLOUD_API_KEY="$val"

	# SF provider keys stored under the sf section
	val=$(_sops_sf_val MISTRAL_API_KEY)
	[ -n "$val" ] && export MISTRAL_API_KEY="$val"
	val=$(_sops_sf_val ZAI_API_KEY)
	[ -n "$val" ] && export ZAI_API_KEY="$val"
	val=$(_sops_sf_val XIAOMI_API_KEY)
	[ -n "$val" ] && export XIAOMI_API_KEY="$val"
	val=$(_sops_sf_val ALIBABA_API_KEY)
	[ -n "$val" ] && export ALIBABA_API_KEY="$val"
	val=$(_sops_sf_val ALIBABA_CODING_PLAN_API_KEY)
	[ -n "$val" ] && export ALIBABA_CODING_PLAN_API_KEY="$val"
	val=$(_sops_sf_val GOOGLE_GENERATIVE_AI_API_KEY)
	if [ -n "$val" ]; then
		export GOOGLE_GENERATIVE_AI_API_KEY="$val" # opencode google provider (AI Studio, free Flash tier)
		export GEMINI_API_KEY="$val"
	fi
	val=$(_sops_sf_val OPENCODE_API_KEY)
	[ -n "$val" ] && export OPENCODE_API_KEY="$val"
	val=$(_sops_sf_val OPENCODE_GO_API_KEY)
	[ -n "$val" ] && export OPENCODE_GO_API_KEY="$val"
	# Enable opencode's built-in websearch tool (Exa-backed) regardless of
	# provider — per opencode docs, OPENCODE_ENABLE_EXA=1 exposes the
	# websearch tool to the LLM even when not on the OpenCode/OpenCode Go
	# provider. Sets independently of OPENCODE_API_KEY above so it works
	# with whatever provider the session is using (MiniMax, google, etc.).
	export OPENCODE_ENABLE_EXA=1
	val=$(_sops_sf_val OLLAMA_API_KEY)
	if [ -n "$val" ]; then
		export OLLAMA_API_KEY="$val"
		export OLLAMA_CLOUD_API_KEY="$val"
	fi

	# LLM Gateway bearer token (aichat / direct API clients)
	val=$(_sops_val llm_gateway bearer_key)
	[ -n "$val" ] && export LLM_GATEWAY_BEARER_KEY="$val"

	# FlakeCache WebDAV token for system sccache.service (nix-cache.nix).
	# WebDAV endpoint and multilevel chain live on the supervised daemon at
	# /host — do not override SCCACHE_WEBDAV_ENDPOINT in shells; per-project
	# buckets split cache hits across repos on the same box.
	val=$(_sops_val flakecache sccache_action_token)
	if [ -n "$val" ]; then
		export SCCACHE_WEBDAV_TOKEN="$val"
	else
		unset SCCACHE_WEBDAV_TOKEN
	fi
	unset SCCACHE_WEBDAV_USERNAME SCCACHE_WEBDAV_PASSWORD
	unset SCCACHE_MULTILEVEL_CHAIN SCCACHE_MULTILEVEL_WRITE_ERROR_POLICY
	unset SCCACHE_WEBDAV_ENDPOINT

	unset -f _sops_val _sops_sf_val
}

alias load-ai-keys='_load_sops_secrets'

# ── Codex ChatGPT OAuth session backup/restore via Bao ──────────────────────
# ~/.codex/auth.json holds a live ChatGPT OAuth token pair (access+refresh,
# from `codex login`), not a static API key -- Bao can't mint or refresh it,
# but it can hold a point-in-time copy so a wiped/new host can restore the
# session instead of forcing a fresh browser/device-auth login. Manual,
# on-demand only: never auto-run on login, so a broken session never silently
# clobbers a good backup (or vice versa). See config/codex/AGENTS.md for the
# `codex login --device-auth` incident this mitigation pattern also covers.
codex-auth-backup() {
	local auth_file="$HOME/.codex/auth.json"
	if [ ! -f "$auth_file" ]; then
		echo "codex-auth-backup: $auth_file not found (run 'codex login' first)" >&2
		return 1
	fi
	if ! command -v bao >/dev/null 2>&1; then
		echo "codex-auth-backup: bao not in PATH" >&2
		return 1
	fi
	if ! BAO_ADDR="${BAO_ADDR:-http://vault-active.vault.svc.cluster.local:8200}" \
		bao kv put -mount=kv codex-mhugo-chatgpt-session "auth_json=@${auth_file}"; then
		echo "codex-auth-backup: bao kv put failed" >&2
		return 1
	fi
	echo "codex-auth-backup: backed up $auth_file to kv/codex-mhugo-chatgpt-session"
}

codex-auth-restore() {
	local auth_file="$HOME/.codex/auth.json"
	if ! command -v bao >/dev/null 2>&1; then
		echo "codex-auth-restore: bao not in PATH" >&2
		return 1
	fi
	if [ -f "$auth_file" ]; then
		cp "$auth_file" "$auth_file.pre-restore-$(date +%s)"
		echo "codex-auth-restore: existing $auth_file backed up alongside" >&2
	fi
	local tmp
	tmp=$(mktemp)
	if ! BAO_ADDR="${BAO_ADDR:-http://vault-active.vault.svc.cluster.local:8200}" \
		bao kv get -field=auth_json -mount=kv codex-mhugo-chatgpt-session >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		echo "codex-auth-restore: no backup at kv/codex-mhugo-chatgpt-session (run codex-auth-backup first)" >&2
		return 1
	fi
	mv "$tmp" "$auth_file"
	chmod 600 "$auth_file"
	echo "codex-auth-restore: restored $auth_file from kv/codex-mhugo-chatgpt-session"
}

# claude-squad harness shortcuts
